# ─────────────────────────────────────────────────────────────────────────────
# Most of this is written for you by `secondbrain init` (or `npm run onboard`).
# Copy this file to .env first (cp .env.example .env), or just run onboarding
# and let it fill .env in.
# Only ANTHROPIC_API_KEY is strictly required to start.
# ─────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
LINKEDIN_SESSION_COOKIE=

# The @-trigger required to address the bot in group chats (DMs don't need it).
# Should match triggerWord in config/profile.json.
TRIGGER_WORD=@assistant

# Users (phone numbers with country code). The names/tones live in
# config/profile.json; these env vars hold only the secrets (phone + email),
# referenced from the profile by the phoneEnv/emailEnv fields.
USER_OWNER=+1XXXXXXXXXX
USER_OWNER_EMAIL=you@icloud.com
# A second household member (e.g. a partner on the Home group). Optional.
USER_PARTNER=+1XXXXXXXXXX
USER_PARTNER_EMAIL=partner@icloud.com

# iMessage Group Chat IDs (from ~/Library/Messages/chat.db)
# Start the bot with no groups configured to see available chat IDs logged.
GROUP_ADMIN=
GROUP_HOME=
GROUP_WORK=
GROUP_FINANCE=
GROUP_HEALTH=
GROUP_JOB_SEARCH=

# DM-only mode: when GROUP_* vars aren't set, send scheduled messages here.
DM_RECIPIENT=+1XXXXXXXXXX

# Finance backend (optional — only needed for the Finance group). Point this at
# your own finance API; without it the finance tools just return errors.
BMM_API_URL=http://localhost:8080
# If your finance backend reads from Supabase, set these; otherwise leave blank.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BMM_USER_ID=

# Calendar — when create_event is called from the Home group, this address (if
# set) is auto-attached as an attendee and an invite is sent. Onboarding sets it
# to your partner's email when you provide one. Leave blank to disable.
HOME_AUTO_ATTENDEE=

# Organic reminders — escalating per-task resurface backoff. The gap before a
# task is surfaced again grows with how many times it's already been surfaced
# (first ping immediate), capped at the last rung. Default ~1d, 2d, 4d, weekly.
HEARTBEAT_BACKOFF_HOURS=24,48,96,168
# After this many surfaces, a still-open task stops being re-pinged and routes to
# the morning brief's "kill it or commit a day" decision question. Default 4.
HEARTBEAT_RETIRE_AFTER=4

# Tier 1 Phase 1: Brain Pulse dedup window (default 18h).
PULSE_RESURFACE_HOURS=18
BRAIN_PULSE_LEAD_DAYS=60
BRAIN_PULSE_EXPIRY_DAYS=7

# Idea Pulse: twice-daily (10:00 + 15:00 ET) proactive "what can I help with /
# ideas" ping. IDEA_PULSE_ENABLED=false kills the cron.
IDEA_PULSE_ENABLED=true

# Tier 1 Phase 2: Hygiene loop. HYGIENE_ENABLED=false kills the Mon 07:30 cron.
HYGIENE_ENABLED=true
HYGIENE_CONFIDENCE_THRESHOLD=0.4
HYGIENE_DEMOTE_MIN_AGE_DAYS=30
HYGIENE_STALE_COMMITMENT_DAYS=90
HYGIENE_MIN_SURFACE_BEFORE_EXPIRE=3

# Tier 1 Phase 3: Content flywheel. Drafts land in SECONDBRAIN_DRAFTS_ROOT
# (default ~/.secondbrain/drafts) — outside any tracked git repo, so
# sync-repos.sh doesn't race a git pull against our local writes.
# (Back-compat: BROWNBOT_DRAFTS_ROOT is also accepted.)
CONTENT_FLYWHEEL_ENABLED=true
SECONDBRAIN_DRAFTS_ROOT=

# Tier 1 Phase 4: Meeting prep + debrief daemon. INTERNAL_DOMAINS is a
# comma-separated allowlist of email domains considered "internal" — any
# attendee whose domain doesn't match makes the meeting "external" and
# eligible for prep + debrief.
INTERNAL_DOMAINS=gmail.com

# Phase 5: iMessage capture daemon. The iMessage channel now passively logs
# EVERY message (both directions, all chats) into imessage_log regardless of the
# trigger word; this daemon batches them through a Haiku pre-filter + Sonnet
# extractor and writes commitments/deadlines/people/decisions into the brain.
# IMESSAGE_DAEMON_INTERVAL_MS: poll cadence (default 600000 = 10 min).
# IMESSAGE_EXTRACT_BATCH: max rows pulled per tick (default 100).
IMESSAGE_DAEMON_INTERVAL_MS=600000
IMESSAGE_EXTRACT_BATCH=100

# Tier 2: inbox-signal daemon. Watches incoming email (Haiku pre-filter + Sonnet
# extraction) and AUTO-CREATES reversible artifacts — delivery/registration
# calendar events, bill tasks, payment-failure alerts, document reference facts —
# then sends one digest DM of what it did. Never spends money or replies (those
# stay behind the Tier 2 actions gate). Reuses SECONDBRAIN_ROUTER_MODEL
# (pre-filter) + SECONDBRAIN_MODEL (extraction).
# INBOX_SIGNAL_ENABLED=false kills the daemon. INTERVAL_MS = poll cadence
# (default 900000 = 15 min). BATCH = emails listed per tick. WINDOW = Spark
# newer_than enumeration window (dedup makes overlap harmless).
INBOX_SIGNAL_ENABLED=true
INBOX_SIGNAL_INTERVAL_MS=900000
INBOX_SIGNAL_BATCH=50
INBOX_SIGNAL_WINDOW=2d

# Browser bridge — optional token auth. If unset, the bridge accepts any
# connection (legacy behavior). If set, the Chrome extension must store the
# matching bridgeToken in chrome.storage to connect.
BROWSER_BRIDGE_TOKEN=
BROWSER_EXTENSION_ID=

# Path guardrails (optional overrides). SECONDBRAIN_GH_ROOT controls where repos
# are expected to live; SECONDBRAIN_ALLOWED_REPOS is a comma-separated list of
# repo names that Second Brain file/spawn tools may read/write into.
# (Back-compat: BROWNBOT_GH_ROOT and BROWNBOT_ALLOWED_REPOS are also accepted.)
SECONDBRAIN_GH_ROOT=
SECONDBRAIN_ALLOWED_REPOS=

# Absolute path to the `claude` CLI used by the spawn_claude_code tool. Required
# because launchd's PATH excludes Homebrew. Default: /opt/homebrew/bin/claude
CLAUDE_CODE_BIN=/opt/homebrew/bin/claude

# Brain dashboard port (default 4000, bound to 127.0.0.1 only)
# (Back-compat: BROWNBOT_DASH_PORT is also accepted.)
SECONDBRAIN_DASH_PORT=4000

# Model selection. Default main model: claude-sonnet-4-6.
# Default router model (sync/async classify + daemon pre-filters): claude-haiku-4-5.
# (Back-compat: BROWNBOT_MODEL and BROWNBOT_ROUTER_MODEL are also accepted.)
SECONDBRAIN_MODEL=
SECONDBRAIN_ROUTER_MODEL=

# Tier 2 Phase 1: Actions layer (propose → confirm → execute). Real-world
# actions that spend money / commit to a person run only after the owner replies
# "go #action:N". ACTIONS_ENABLED=false is the global kill switch (both propose
# and confirm refuse). Daily + weekly caps are a single global pool across all
# actions; only completed actions count toward them. ACTIONS_REORDER_DRY_RUN=true
# stops the browser executor just before the final "place order" click and
# returns a simulated outcome — use it to exercise the loop without spending.
ACTIONS_ENABLED=true
ACTIONS_DAILY_CAP_USD=100
ACTIONS_WEEKLY_CAP_USD=400
ACTIONS_REORDER_DRY_RUN=false

# Canairy early-warning integration (optional local FastAPI service). Leave the
# default if you don't run one — the tool just returns errors when it's absent.
CANAIRY_API_URL=http://localhost:5555/api/v1
# How long before re-pinging the same persisting TIGHTEN-UP condition (hours)
CANAIRY_RESURFACE_HOURS=24

# MCP servers are configured in mcp-servers.json (same format as Claude Desktop)
# Copy from: ~/Library/Application Support/Claude/claude_desktop_config.json
