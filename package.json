{
  "name": "secondbrain",
  "version": "1.0.0",
  "description": "A personal AI assistant that runs on your Mac, talks over iMessage, and works as a second brain.",
  "type": "module",
  "bin": {
    "secondbrain": "dist/cli.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "context/_examples/",
    "context/brain-pulse/",
    "context/idea-pulse/",
    "context/reflection/",
    "context/content/",
    "context/shared/security.md",
    "context/seeds/",
    "launchd/",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "bash scripts/smoke-test.sh",
    "onboard": "tsx scripts/onboard.ts",
    "onboard:dry": "tsx scripts/onboard.ts --dry",
    "auth:google": "tsx scripts/google-auth.ts",
    "backfill:google-tasks": "tsx scripts/backfill-google-tasks.ts",
    "meeting-daemon": "tsx scripts/meeting-daemon.ts",
    "meeting-daemon:test": "tsx scripts/meeting-daemon.ts --test",
    "meeting-daemon:test-debrief": "tsx scripts/meeting-daemon.ts --test --test-debrief",
    "inbox-signal-daemon": "tsx scripts/inbox-signal-daemon.ts",
    "inbox-signal-daemon:test": "tsx scripts/inbox-signal-daemon.ts --test",
    "import:contacts": "tsx scripts/import-contacts.ts",
    "import:contacts:dry": "tsx scripts/import-contacts.ts --dry",
    "seed:facts": "tsx scripts/seed-facts.ts",
    "seed:facts:dry": "tsx scripts/seed-facts.ts --dry",
    "doctor": "tsx scripts/doctor.ts",
    "backfill:imessages": "tsx scripts/backfill-imessages.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "googleapis": "^173.0.0",
    "node-cron": "^4.2.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
